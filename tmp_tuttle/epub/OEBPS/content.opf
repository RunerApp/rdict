    <dc:title>Tuttle Mini Japanese Dictionary</dc:title>
    <dc:identifier opf:scheme="ISBN">978-4-8053-1223-0</dc:identifier>
    <dc:creator opf:role="aut">Yuki Shimada</dc:creator>
    <dc:publisher>Tuttle Publishing</dc:publisher>
